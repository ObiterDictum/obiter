# Local caches
.cache/
tmp/
temp/

# Machine-local agent / review tooling — never repo content. These are
# per-developer scratch (editor/agent configs, recorded review state, runtime
# logs). Each developer's set differs; keep them out of tracked noise.
.claude/
.cursor/
.code-review/
.code-review.json
.pi-lens/
.pi-subagents/

# Local API object storage (OBITER_STORAGE_ROOT default) — runtime data.
.obiter-storage/

# Synthetic-v2 local API outputs, review mapping, and spend ledger.
.synthetic-v2/
data/synthetic-v2-review/

# Generated by scripts/architecture-diagrams.py
scripts/diagrams.json

# Brand working files. The SVG sources, icon ladder and lockups under
# docs/brand/ are tracked; the generated presentation kit (guideline boards,
# application mockups, social renders) and the Python generators that produce
# them are large binaries or local tooling and stay out of the repo.
docs/brand/kit/
scripts/brand/

# Security assessments and pentest harnesses live in obiter-ops because
# this repo is public; a harness moves here as ordinary negative permission
# tests only once its findings are closed.
docs/security/
services/api/src/pentest-*.test.ts
