{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["tailwindcss"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/generate-pdf-fixtures.mjs",
        "tools/oxlint/anti-slop/effect/index.ts",
      ],
    },
    "apps/web": {
      "entry": [
        "lane-target.d.mts",
        "playwright.config.ts",
        "e2e/{global-setup,renderer-server}.ts",
        "e2e/**/*.spec.ts",
        "src/routes/**/*.{ts,tsx}",
      ],
      "playwright": false,
      "ignoreBinaries": ["psql"],
      "ignoreDependencies": ["unpdf"],
    },
    "packages/contracts": {
      "ignoreIssues": {
        "src/agent-api.ts": ["duplicates"],
      },
    },
  },
}
