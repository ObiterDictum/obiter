{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["tailwindcss"],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "scripts/export-training-data.ts": ["exports"],
    "scripts/synthetic-v2/budget.ts": ["exports"],
    "scripts/synthetic-v2/governance.ts": ["exports"],
    "scripts/synthetic-v2/models.ts": ["exports"],
    "scripts/synthetic-v2/validation.ts": ["exports"],
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/generate-pdf-fixtures.mjs",
        "tools/oxlint/anti-slop/effect/index.ts",
      ],
    },
    "apps/web": {
      "entry": [
        "lane-target.d.mts",
        "playwright.config.ts",
        "e2e/{global-setup,renderer-server}.ts",
        "e2e/**/*.spec.ts",
        "src/routes/**/*.{ts,tsx}",
      ],
      "playwright": false,
      "ignoreBinaries": ["psql"],
      "ignoreDependencies": ["unpdf"],
    },
    "packages/app-shell": {
      "ignoreIssues": {
        "src/lib/desktop-bridge.ts": ["exports"],
        "src/views/LegislationActView.tsx": ["types"],
        "src/views/legislation-document-query.ts": ["types"],
      },
    },
    "packages/contracts": {
      "ignoreIssues": {
        "src/agent-api.ts": ["duplicates"],
      },
    },
  },
}
