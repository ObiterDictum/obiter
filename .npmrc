# ONNX Runtime's postinstall downloads the optional CUDA and TensorRT execution
# providers (onnxruntime-linux-x64-gpu, ~343 MB unpacked) on Linux x64 unless it
# is told to skip them.
#
# Every ONNX session Obiter configures asks for the CPU device
# (services/api/src/redaction-detection.ts passes device: 'cpu'; the browser
# path uses onnxruntime-web; the desktop bundle excludes node_modules), and
# nothing in the tree configures a CUDA or TensorRT provider. Leaving them on
# costs every cold install, CI cache miss and container layer the download plus
# the disk.
#
# A host that does need them opts in without editing this file:
#   ONNXRUNTIME_NODE_INSTALL_CUDA=v12 pnpm rebuild onnxruntime-node
# Rebuild rather than install again: pnpm replays the postinstall result already
# cached in its store, so a second pnpm install is not a mode switch.
onnxruntime-node-install-cuda=skip
