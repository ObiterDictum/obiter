{
  "name": "obiter",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "db:migrate": "bun services/api/src/migrate.ts",
    "rebuild:search-index": "bun services/api/src/rebuild-search-index.ts",
    "rebuild:legislation-index": "bun services/api/src/rebuild-legislation-index.ts",
    "check:search-parity": "bun services/api/src/check-search-parity.ts",
    "dev:api": "bun run --filter @obiter/api --if-present dev",
    "dev:api:node": "bun run --filter @obiter/api --if-present dev:node",
    "dev:api:bun": "bun run --filter @obiter/api --if-present dev:bun",
    "dev:desktop": "bun run --filter @obiter/desktop --if-present dev",
    "dev:desktop:api": "bun run --parallel --filter @obiter/api --filter @obiter/desktop --if-present dev",
    "dev:web": "bun run --filter @obiter/web --if-present dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint && eslint .",
    "prefetch:rampart": "bun scripts/prefetch-rampart-model.ts",
    "bench:guard": "bun scripts/bench-guard.ts",
    "perf:bundle-budget": "bun scripts/perf/bundle-budget.mjs",
    "perf:desktop-budget": "bun scripts/perf/desktop-budget.mjs",
    "perf:web-load": "bun scripts/perf/web-load-runner.mjs",
    "load:upload-extraction": "bun scripts/load/upload-extraction-load.mjs",
    "benchmark:search": "bun packages/search-client/src/benchmark/run.ts",
    "benchmark:search-corpus": "bun scripts/search-corpus-relevance/run.ts",
    "benchmark:legislation-corpus": "bun scripts/legislation-relevance/run.ts",
    "synthetic-v2:smoke": "bun scripts/synthetic-v2/smoke.ts",
    "synthetic-v2:canary": "bun scripts/synthetic-v2/smoke.ts --profile=tournament-canary",
    "synthetic-v2:tournament": "bun scripts/synthetic-v2/run.ts --stage=tournament",
    "synthetic-v2:tournament:assemble": "bun scripts/synthetic-v2/run.ts --assemble-tournament",
    "test:e2e": "bun run --filter @obiter/web test:e2e",
    "test": "bun run --workspaces --if-present test && bun test --isolate scripts/api-ingress scripts/load scripts/perf scripts/synthetic-v2 scripts/redact-acceptance scripts/search-corpus-relevance scripts/legislation-relevance",
    "typecheck": "bun run --workspaces --if-present typecheck && tsc --noEmit -p scripts/synthetic-v2/tsconfig.json && tsc --noEmit -p scripts/redact-acceptance/tsconfig.json && tsc --noEmit -p scripts/search-corpus-relevance/tsconfig.json && tsc --noEmit -p scripts/legislation-relevance/tsconfig.json"
  },
  "_comment:oxlint-coupled": "oxlint and @oxlint/plugins must be on the same exact version (1.73.0) \u2014 update together; bun update would otherwise break the plugin",
  "_comment:oxlint": "1.73.0 must match @oxlint/plugins \u2014 see _comment:oxlint-coupled",
  "_comment:@oxlint/plugins": "1.73.0 must match oxlint \u2014 see _comment:oxlint-coupled",
  "devDependencies": {
    "@obiter/test-dom": "workspace:*",
    "@oxlint/plugins": "1.73.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@types/bun": "1.4.2",
    "@types/node": "^22.15.18",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.30.0",
    "jsdom": "^29.1.1",
    "oxlint": "1.73.0",
    "prettier": "^3.9.5",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ]
}
