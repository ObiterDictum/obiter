{
  "name": "obiter",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "dev:desktop": "bun run --filter @obiter/desktop --if-present dev",
    "dev:web": "bun run --filter @obiter/web --if-present dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint && eslint . && bun scripts/lint/check-comments.mjs && bun scripts/lint/check-private-paths.mjs",
    "bench:guard": "bun scripts/bench-guard.ts",
    "perf:bundle-budget": "bun scripts/perf/bundle-budget.mjs",
    "perf:desktop-budget": "bun scripts/perf/desktop-budget.mjs",
    "synthetic-v2:smoke": "bun scripts/synthetic-v2/smoke.ts",
    "synthetic-v2:canary": "bun scripts/synthetic-v2/smoke.ts --profile=tournament-canary",
    "synthetic-v2:tournament": "bun scripts/synthetic-v2/run.ts --stage=tournament",
    "synthetic-v2:tournament:assemble": "bun scripts/synthetic-v2/run.ts --assemble-tournament",
    "test": "bun run --workspaces --if-present test && bun test --isolate scripts/perf scripts/synthetic-v2 scripts/redact-acceptance scripts/lint",
    "typecheck": "bun run --workspaces --if-present typecheck && tsc --noEmit -p scripts/synthetic-v2/tsconfig.json && tsc --noEmit -p scripts/redact-acceptance/tsconfig.json"
  },
  "_comment:oxlint-coupled": "oxlint and @oxlint/plugins must be on the same exact version (1.73.0) — update together; bun update would otherwise break the plugin",
  "_comment:oxlint": "1.73.0 must match @oxlint/plugins — see _comment:oxlint-coupled",
  "_comment:@oxlint/plugins": "1.73.0 must match oxlint — see _comment:oxlint-coupled",
  "devDependencies": {
    "@obiter/test-dom": "workspace:*",
    "@oxlint/plugins": "1.73.0",
    "@playwright/test": "^1.62.1",
    "@types/bun": "1.4.2",
    "@types/node": "^22.15.18",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.30.0",
    "oxlint": "1.73.0",
    "prettier": "^3.9.5",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ]
}
