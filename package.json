{
  "name": "obiter",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "db:migrate": "tsx services/api/src/migrate.ts",
    "rebuild:search-index": "tsx services/api/src/rebuild-search-index.ts",
    "check:search-parity": "tsx services/api/src/check-search-parity.ts",
    "dev:api": "pnpm --filter @obiter/api --if-present dev",
    "dev:desktop": "pnpm --filter @obiter/desktop --if-present dev",
    "dev:desktop:api": "pnpm --parallel --stream --filter @obiter/api --filter @obiter/desktop --if-present dev",
    "dev:web": "pnpm --filter @obiter/web --if-present dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint && eslint .",
    "prefetch:rampart": "tsx scripts/prefetch-rampart-model.ts",
    "bench:guard": "tsx scripts/bench-guard.ts",
    "benchmark:search": "tsx packages/search-client/src/benchmark/run.ts",
    "synthetic-v2:smoke": "tsx scripts/synthetic-v2/smoke.ts",
    "synthetic-v2:canary": "tsx scripts/synthetic-v2/smoke.ts --profile=tournament-canary",
    "synthetic-v2:tournament": "tsx scripts/synthetic-v2/run.ts --stage=tournament",
    "synthetic-v2:tournament:assemble": "tsx scripts/synthetic-v2/run.ts --assemble-tournament",
    "test:e2e": "pnpm --filter @obiter/web test:e2e",
    "test": "pnpm -r --if-present test && vitest run scripts/synthetic-v2 scripts/redact-acceptance",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p scripts/synthetic-v2/tsconfig.json && tsc --noEmit -p scripts/redact-acceptance/tsconfig.json"
  },
  "_comment:oxlint-coupled": "oxlint and @oxlint/plugins must be on the same exact version (1.73.0) — update together; pnpm update would otherwise break the plugin",
  "_comment:oxlint": "1.73.0 must match @oxlint/plugins — see _comment:oxlint-coupled",
  "_comment:@oxlint/plugins": "1.73.0 must match oxlint — see _comment:oxlint-coupled",
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.8.15"
    }
  },
  "devDependencies": {
    "@oxlint/plugins": "1.73.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.18",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.30.0",
    "oxlint": "1.73.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
